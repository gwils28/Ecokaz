# Copy to .env and change every value. .env is git-ignored.
POSTGRES_USER=ecokaz
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ecokaz
ECOKAZ_ENV=dev
ECOKAZ_DATABASE_URL=postgresql+psycopg://ecokaz:change-me@db:5432/ecokaz
# Hostname served by Caddy (localhost gets an internal TLS certificate)
ECOKAZ_HOST=localhost
# The password appears twice (here and in ECOKAZ_DATABASE_URL): change both together.
ECOKAZ_HSTS_MAX_AGE=0
